# Copy to .env for local runs (npm run dev reads it automatically).
PORT=3000

# Public base URL used in record/share links. On Render this is set for you (RENDER_EXTERNAL_URL); leave blank there.
PUBLIC_URL=http://localhost:3000

# Access token for the MCP endpoint. Claude connects to: <PUBLIC_URL>/mcp?token=<MCP_TOKEN>
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_TOKEN=dev-token-change-me

# The single test login for the web app.
DEMO_USER=qa@millproof.demo
DEMO_PASSWORD=MillProof@2026
DEMO_NAME=Demo QA Engineer

# Admin account (can delete records and reset demo data). In production it is disabled unless ADMIN_PASSWORD is set.
ADMIN_USER=admin@millproof.demo
ADMIN_PASSWORD=change-me-admin

# Signs the login cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Database. Leave DATABASE_URL empty to use a local SQLite file (SQLITE_PATH).
# On Render, DATABASE_URL is the free Postgres "Internal Database URL".
DATABASE_URL=
SQLITE_PATH=./data/millproof.db

# Load the 6 sample certificates when the database is empty.
SEED_ON_EMPTY=true
